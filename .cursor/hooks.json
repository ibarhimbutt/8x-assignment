{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "python3 .cursor/hooks/capture.py",
        "timeout": 15
      }
    ],
    "afterAgentResponse": [
      {
        "command": "python3 .cursor/hooks/capture.py",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": "python3 .cursor/hooks/capture.py",
        "timeout": 15,
        "loop_limit": 0
      }
    ]
  }
}
