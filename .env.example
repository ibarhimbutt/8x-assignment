# Cookie signing for email/password sessions. Optional in this demo —
# a fallback secret is used if unset. Set one in production.
AUTH_SECRET=

# Optional. Summaries, live notes, Ask Meetings.
GEMINI_API_KEY=

# Optional. Preferred intelligence layer (OpenAI-compatible).
AGENT_ROUTER_API_KEY=
AGENT_ROUTER_BASE_URL=
AGENT_ROUTER_MODEL=
AGENT_ROUTER_STT_MODEL=

# Optional speech-to-text (first match wins): Deepgram, OpenAI Whisper, Gemini, Agent Router.
DEEPGRAM_API_KEY=
STT_API_KEY=
OPENAI_API_KEY=

# Google Calendar OAuth (required for real calendar sync).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Reserved. Auth in this build is cookie-session (see README).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
