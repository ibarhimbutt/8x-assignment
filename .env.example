# Cookie signing for email/password sessions. Optional in this demo —
# a fallback secret is used if unset. Set one in production.
AUTH_SECRET=

# Optional. If unset, Ask Meetings uses deterministic answers from seed data.
GEMINI_API_KEY=

# Reserved. Auth in this build is cookie-session (see README).
# Wire these if you swap in Supabase later.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
